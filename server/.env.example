NODE_ENV=development

# App server and database
PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/coursehub

# JWT signing keys
JWT_SECRET=
ADMIN_JWT_SECRET=

# Exact frontend/API origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Sessions
COOKIE_SAME_SITE=lax
# Number of trusted reverse-proxy hops
TRUST_PROXY_HOPS=0

# Persistent auth throttling, per IP and admin account
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_LIMIT=20

# Azure AD / Microsoft Graph auth
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Register callback in the Microsoft Entra application for sign-in
REDIRECT_URI=http://localhost:8080/api/auth/login/redirect

# Client links
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# Academic cache TTL
ACADEMIC_CACHE_SECONDS=86400

# OneDrive storage
ONEDRIVE_FOLDER_ID=
# Directory for private refresh tokens and the access-token cache
ONEDRIVE_TOKEN_DIR=
# Upload staging directory, shared by API workers
UPLOAD_TEMP_DIR=
# Optional Azure-registered callback for provisioning
ONEDRIVE_REDIRECT_URI=

# ImageKit - get from ImageKit dashboard > Developer Options
IMAGEKIT_PUBLIC_KEY=<your_imagekit_public_key>
IMAGEKIT_PRIVATE_KEY=<your_imagekit_private_key>
IMAGEKIT_URL_ENDPOINT=<your_imagekit_url_endpoint>

# Ops telemetry
OPS_LOGGING_ENABLED=false
OPS_LOG_INGEST_URL=
OPS_LOG_INGEST_SECRET=

# Administrator provisioning: npm run admin
ADMIN_USER_ID= # 1-128 characters
ADMIN_PASSWORD= # >=12 characters
